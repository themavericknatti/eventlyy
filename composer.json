{
    "name": "ace-core/ace",
    "description": "A lightweight, high-performance PHP 8.2+ MVC framework with Active Record, Multi-Template system, Queue Worker, unified Payments, and API Idempotency.",
    "keywords": [
        "framework",
        "mvc",
        "php",
        "active-record",
        "orm",
        "queue",
        "templates",
        "idempotency",
        "payments"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/themavericknatti/eventlyy",
    "support": {
        "issues": "https://github.com/themavericknatti/eventlyy/issues",
        "source": "https://github.com/themavericknatti/eventlyy"
    },
    "authors": [
        {
            "name": "Celionatti",
            "email": "celionattidev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^6.9 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ace\\": "src/",
            "App\\": "app/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "ace"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
