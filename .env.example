# Application Configuration
APP_ENV=local
APP_NAME="Ace Application"
APP_URL="http://localhost:8000"
APP_TIMEZONE="UTC"

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ace_db
DB_USER=root
DB_PASS=

# SMTP Mail Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Ace Application"

# Optional Payment Gateway Credentials (Paystack, Stripe, Flutterwave)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""

FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
