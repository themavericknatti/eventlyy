# Application Configuration
APP_ENV=production
APP_NAME="Evently Ticket Master"
APP_URL="https://yourdomain.com"
APP_TIMEZONE="Africa/Lagos"

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_production_dbname
DB_USER=your_production_dbuser
DB_PASS=your_production_dbpassword

# SMTP Mail Configuration
MAIL_HOST=smtp.yourmailserver.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Evently"

# Paystack Production Credentials
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"

# Stripe Production Credentials
STRIPE_PUBLIC_KEY="pk_live_your_stripe_public_key"
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"

# Flutterwave Production Credentials
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_LIVE-your_flutterwave_public_key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_LIVE-your_flutterwave_secret_key"
