<?php

if (php_sapi_name() !== 'cli') {
    echo "This script can only be run from the CLI.\n";
    exit(1);
}

require_once __DIR__ . '/vendor/autoload.php';

use Ace\Application;

$rootDir = __DIR__;

// Command arguments
$args = $argv;
$command = $args[1] ?? 'help';

echo "\n✨ Mini PHP MVC - Ace CLI Command Runner\n";
echo "==========================================\n";

// Boot up basic app variables
$appConfig = require_once $rootDir . '/config/app.php';
$dbConfig = require_once $rootDir . '/config/database.php';
$config = array_merge($appConfig, ['db' => $dbConfig]);

$app = null;
try {
    $app = new Application($rootDir, $config);
} catch (\Throwable $e) {
    if (in_array($command, ['migrate', 'migrate:rollback', 'migrate:status', 'db:seed', 'make:apikey', 'apikey:list', 'apikey:revoke'])) {
        echo "❌ Database Error: " . $e->getMessage() . "\n\n";
        exit(1);
    }
}

switch ($command) {
    case 'migrate':
        echo "🏃 Running migrations...\n";
        try {
            if ($app->db) {
                $manager = new \Ace\MigrationManager($app->db->pdo, $rootDir . '/migrations');
                $manager->applyMigrations();
            } else {
                echo "❌ Error: Database config is empty.\n\n";
            }
        } catch (Exception $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'migrate:rollback':
        echo "🏃 Rolling back last migration batch...\n";
        try {
            if ($app->db) {
                $manager = new \Ace\MigrationManager($app->db->pdo, $rootDir . '/migrations');
                $manager->rollback();
            } else {
                echo "❌ Error: Database config is empty.\n\n";
            }
        } catch (Exception $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'migrate:status':
        echo "🏃 Checking migration status...\n";
        try {
            if ($app->db) {
                $manager = new \Ace\MigrationManager($app->db->pdo, $rootDir . '/migrations');
                $manager->status();
            } else {
                echo "❌ Error: Database config is empty.\n\n";
            }
        } catch (Exception $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'make:migration':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the migration description. e.g. php ace make:migration create_products_table\n\n";
            exit(1);
        }
        try {
            if ($app->db) {
                $manager = new \Ace\MigrationManager($app->db->pdo, $rootDir . '/migrations');
                $filePath = $manager->makeMigration($name);
                echo "✅ Created Migration: migrations/" . basename($filePath) . "\n\n";
            } else {
                echo "❌ Error: Database config is empty.\n\n";
            }
        } catch (Exception $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'make:controller':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the controller name. e.g. php ace make:controller Product\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        if (!str_ends_with($name, 'Controller')) {
            $name .= 'Controller';
        }
        
        $filePath = $rootDir . "/app/Controllers/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Controller '{$name}' already exists.\n\n";
            exit(1);
        }

        $template = "<?php\n\nnamespace App\Controllers;\n\nuse Ace\Controller;\nuse Ace\Request;\n\nclass {$name} extends Controller\n{\n    public function index(Request \$request): string\n    {\n        return \$this->render('home', [\n            'title' => '{$name}'\n        ]);\n    }\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Controller: app/Controllers/{$name}.php\n\n";
        break;

    case 'make:model':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the model name. e.g. php ace make:model Product\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        $tableName = strtolower($name) . 's'; // simple pluralization
        
        $filePath = $rootDir . "/app/Models/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Model '{$name}' already exists.\n\n";
            exit(1);
        }

        $template = "<?php\n\nnamespace App\Models;\n\nuse Ace\Model;\n\nclass {$name} extends Model\n{\n    public static function tableName(): string\n    {\n        return '{$tableName}';\n    }\n\n    public function primaryKey(): string\n    {\n        return 'id';\n    }\n\n    public function rules(): array\n    {\n        return [\n            // Define validation rules here\n        ];\n    }\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Model: app/Models/{$name}.php\n\n";
        break;

    case 'make:middleware':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the middleware name. e.g. php ace make:middleware Cors\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        if (!str_ends_with($name, 'Middleware')) {
            $name .= 'Middleware';
        }
        
        $filePath = $rootDir . "/app/Middlewares/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Middleware '{$name}' already exists.\n\n";
            exit(1);
        }

        $template = "<?php\n\nnamespace App\Middlewares;\n\nuse Ace\Middleware;\n\nclass {$name} extends Middleware\n{\n    protected function run(): void\n    {\n        // Implement middleware check here\n    }\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Middleware: app/Middlewares/{$name}.php\n\n";
        break;

    case 'make:action':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the action name. e.g. php ace make:action CreateOrderAction\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        if (!str_ends_with($name, 'Action')) {
            $name .= 'Action';
        }
        
        $actionsDir = $rootDir . '/app/Actions';
        if (!is_dir($actionsDir)) {
            mkdir($actionsDir, 0755, true);
        }
        
        $filePath = $actionsDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Action '{$name}' already exists.\n\n";
            exit(1);
        }
        
        $template = "<?php\n\nnamespace App\Actions;\n\nclass {$name}\n{\n    public function execute(mixed ...\$params): mixed\n    {\n        // Implement discrete business logic here\n        return null;\n    }\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Action: app/Actions/{$name}.php\n\n";
        break;

    case 'make:event':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the event name. e.g. php ace make:event UserRegistered\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        $eventsDir = $rootDir . '/app/Events';
        if (!is_dir($eventsDir)) {
            mkdir($eventsDir, 0755, true);
        }
        
        $filePath = $eventsDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Event '{$name}' already exists.\n\n";
            exit(1);
        }
        
        $template = "<?php\n\nnamespace App\Events;\n\nclass {$name}\n{\n    public function __construct(\n        // Define event properties here\n    ) {}\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Event: app/Events/{$name}.php\n\n";
        break;

    case 'make:listener':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the listener name. e.g. php ace make:listener SendWelcomeEmail\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        $listenersDir = $rootDir . '/app/Listeners';
        if (!is_dir($listenersDir)) {
            mkdir($listenersDir, 0755, true);
        }
        
        $filePath = $listenersDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Listener '{$name}' already exists.\n\n";
            exit(1);
        }
        
        $template = "<?php\n\nnamespace App\Listeners;\n\nclass {$name}\n{\n    public function handle(mixed ...\$payload): void\n    {\n        // Handle the incoming dispatched event\n    }\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Listener: app/Listeners/{$name}.php\n\n";
        break;

    case 'make:service':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the service name. e.g. php ace make:service OrderService\n\n";
            exit(1);
        }

        $name = ucfirst($name);
        if (!str_ends_with($name, 'Service')) {
            $name .= 'Service';
        }

        $servicesDir = $rootDir . '/app/Services';
        if (!is_dir($servicesDir)) {
            mkdir($servicesDir, 0755, true);
        }

        $filePath = $servicesDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Service '{$name}' already exists.\n\n";
            exit(1);
        }

        $template = "<?php\n\nnamespace App\Services;\n\nuse Ace\Service;\n\nclass {$name} extends Service\n{\n    public function __construct(\n        // Inject repositories or dependencies here\n    ) {}\n\n    // Implement domain business methods here\n}\n";

        file_put_contents($filePath, $template);
        echo "✅ Created Service: app/Services/{$name}.php\n\n";
        break;

    case 'make:repository':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the repository name. e.g. php ace make:repository UserRepository\n\n";
            exit(1);
        }

        $name = ucfirst($name);
        if (!str_ends_with($name, 'Repository')) {
            $name .= 'Repository';
        }

        $baseModel = substr($name, 0, -10); // Strip 'Repository'

        $reposDir = $rootDir . '/app/Repositories';
        if (!is_dir($reposDir)) {
            mkdir($reposDir, 0755, true);
        }

        $filePath = $reposDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Repository '{$name}' already exists.\n\n";
            exit(1);
        }

        $template = "<?php\n\nnamespace App\Repositories;\n\nuse Ace\Repository;\nuse App\Models\\{$baseModel};\n\nclass {$name} extends Repository\n{\n    protected string \$modelClass = {$baseModel}::class;\n\n    // Add custom model-specific queries or data access methods here\n}\n";

        file_put_contents($filePath, $template);
        echo "✅ Created Repository: app/Repositories/{$name}.php\n\n";
        break;

    case 'make:request':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the request name. e.g. php ace make:request StoreUserRequest\n\n";
            exit(1);
        }

        $name = ucfirst($name);
        if (!str_ends_with($name, 'Request')) {
            $name .= 'Request';
        }

        $requestsDir = $rootDir . '/app/Requests';
        if (!is_dir($requestsDir)) {
            mkdir($requestsDir, 0755, true);
        }

        $filePath = $requestsDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Request '{$name}' already exists.\n\n";
            exit(1);
        }

        $template = "<?php\n\nnamespace App\Requests;\n\nuse Ace\FormRequest;\n\nclass {$name} extends FormRequest\n{\n    public function authorize(): bool\n    {\n        return true;\n    }\n\n    public function rules(): array\n    {\n        return [\n            // Define validation rules (e.g. 'email' => 'required|email|max:255')\n        ];\n    }\n\n    public function messages(): array\n    {\n        return [\n            // Custom error messages (optional)\n        ];\n    }\n}\n";

        file_put_contents($filePath, $template);
        echo "✅ Created FormRequest: app/Requests/{$name}.php\n\n";
        break;

    case 'make:seeder':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the seeder name. e.g. php ace make:seeder UserSeeder\n\n";
            exit(1);
        }
        
        $name = ucfirst($name);
        if (!str_ends_with($name, 'Seeder')) {
            $name .= 'Seeder';
        }
        
        $seedsDir = $rootDir . '/seeds';
        if (!is_dir($seedsDir)) {
            mkdir($seedsDir, 0755, true);
        }
        
        $filePath = $seedsDir . "/{$name}.php";
        if (file_exists($filePath)) {
            echo "❌ Error: Seeder '{$name}' already exists.\n\n";
            exit(1);
        }
        
        $template = "<?php\n\nuse Ace\Seeder;\n\nclass {$name} extends Seeder\n{\n    public function run(): void\n    {\n        // Insert seed data using \$this->db or Active Record Models\n    }\n}\n";
        
        file_put_contents($filePath, $template);
        echo "✅ Created Seeder: seeds/{$name}.php\n\n";
        break;

    case 'db:seed':
        echo "🌱 Running database seeders...\n";
        try {
            if (!$app || !$app->db) {
                echo "❌ Error: Database connection is not available.\n\n";
                exit(1);
            }
            
            $seederClass = 'DatabaseSeeder';
            foreach ($args as $arg) {
                if (str_starts_with($arg, '--class=')) {
                    $seederClass = substr($arg, 8);
                }
            }
            
            $seederFile = $rootDir . "/seeds/{$seederClass}.php";
            if (!file_exists($seederFile)) {
                echo "❌ Error: Seeder file 'seeds/{$seederClass}.php' not found.\n\n";
                exit(1);
            }
            
            require_once $seederFile;
            if (!class_exists($seederClass)) {
                echo "❌ Error: Class '{$seederClass}' not found in '{$seederFile}'.\n\n";
                exit(1);
            }
            
            echo "  🌱 Seeding: {$seederClass}...\n";
            $seeder = new $seederClass($app->db->pdo);
            $seeder->run();
            echo "✅ Database seeded successfully with {$seederClass}!\n\n";
        } catch (\Throwable $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'view:clear':
        echo "🧹 Clearing compiled view cache...\n";
        $cacheDir = $rootDir . '/storage/views';
        if (is_dir($cacheDir)) {
            $files = glob($cacheDir . '/*.php');
            $count = 0;
            foreach ($files as $file) {
                if (is_file($file)) {
                    if (@unlink($file)) {
                        $count++;
                    }
                }
            }
            echo "✅ Cleared {$count} cached view files.\n\n";
        } else {
            echo "✅ View cache directory is already empty.\n\n";
        }
        break;

    case 'serve':
        $host = '127.0.0.1';
        $port = 8000;
        foreach ($args as $arg) {
            if (str_starts_with($arg, '--port=')) {
                $port = (int) substr($arg, 7);
            }
            if (str_starts_with($arg, '--host=')) {
                $host = substr($arg, 7);
            }
        }
        echo "🚀 Development server started on [http://{$host}:{$port}]\n";
        echo "   Document root is: public/\n";
        echo "   Press Ctrl+C to stop the server\n\n";
        passthru(PHP_BINARY . " -S {$host}:{$port} -t public \"{$rootDir}/src/server.php\"");
        break;

    case 'down':
        $downDir = $rootDir . '/storage/framework';
        if (!is_dir($downDir)) {
            mkdir($downDir, 0755, true);
        }

        $message = 'We are performing scheduled maintenance. Please check back shortly.';
        $retry = 60;
        $secret = null;

        foreach ($args as $arg) {
            if (str_starts_with($arg, '--message=')) {
                $message = substr($arg, 10);
            }
            if (str_starts_with($arg, '--retry=')) {
                $retry = (int) substr($arg, 8);
            }
            if (str_starts_with($arg, '--secret=')) {
                $secret = substr($arg, 9);
            }
        }

        $payload = [
            'time' => time(),
            'message' => $message,
            'retry' => $retry,
            'secret' => $secret,
        ];

        file_put_contents($downDir . '/down', json_encode($payload, JSON_PRETTY_PRINT));
        echo "🚧 Application is now in maintenance mode.\n";
        if ($secret) {
            echo "   Bypass secret: ?secret={$secret}\n";
        }
        echo "\n";
        break;

    case 'up':
        $downFile = $rootDir . '/storage/framework/down';
        if (file_exists($downFile)) {
            @unlink($downFile);
            echo "🚀 Application is now live!\n\n";
        } else {
            echo "ℹ️  Application is already live.\n\n";
        }
        break;

    case 'test':
        $phpunitBin = $rootDir . '/vendor/bin/phpunit';
        if (DIRECTORY_SEPARATOR === '\\') {
            $phpunitBat = $rootDir . '/vendor/bin/phpunit.bat';
            if (file_exists($phpunitBat)) {
                $phpunitBin = $phpunitBat;
            }
        }

        if (!file_exists($phpunitBin) && !file_exists($rootDir . '/vendor/bin/phpunit.bat')) {
            echo "❌ PHPUnit is not installed. Run 'composer install' to install test dependencies.\n\n";
            exit(1);
        }

        echo "🧪 Running Ace Test Suite...\n\n";
        $extraArgs = implode(' ', array_slice($args, 2));
        passthru("\"{$phpunitBin}\" {$extraArgs}");
        break;

    case 'make:apikey':
        $name = $args[2] ?? null;
        if (!$name) {
            echo "❌ Error: Please specify the API key name. e.g. php ace make:apikey \"React Frontend\"\n\n";
            exit(1);
        }

        $expiresAt = null;
        $permissions = ['*'];

        foreach (array_slice($args, 3) as $arg) {
            if (str_starts_with($arg, '--expires=')) {
                $days = (int) substr($arg, 10);
                if ($days > 0) {
                    $expiresAt = date('Y-m-d H:i:s', strtotime("+{$days} days"));
                }
            }
            if (str_starts_with($arg, '--permissions=')) {
                $rawPerms = substr($arg, 14);
                $permissions = array_filter(array_map('trim', explode(',', $rawPerms)));
            }
        }

        try {
            $keyData = \Ace\ApiKey::generate($name, $permissions, $expiresAt);
            echo "🔑 API Key Generated Successfully!\n";
            echo "------------------------------------------\n";
            echo "  Name:        " . $keyData['name'] . "\n";
            echo "  Prefix:      " . $keyData['prefix'] . "\n";
            echo "  Key:         " . $keyData['plain_key'] . "\n";
            echo "  Permissions: " . json_encode($keyData['permissions']) . "\n";
            echo "  Expires:     " . ($keyData['expires_at'] ?? 'Never') . "\n";
            echo "------------------------------------------\n";
            echo "⚠️  IMPORTANT: Copy and save this key now. You will NOT be able to view it again!\n";
            echo "   Use in frontend (React/Next/Nuxt) via:\n";
            echo "   Authorization: Bearer " . $keyData['plain_key'] . "\n";
            echo "   OR X-Api-Key: " . $keyData['plain_key'] . "\n\n";
        } catch (\Throwable $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'apikey:list':
        echo "📋 Registered API Keys:\n";
        echo "------------------------------------------------------------------------------------------------------\n";
        try {
            $keys = \Ace\ApiKey::all();
            if (empty($keys)) {
                echo "  No API keys found. Generate one with: php ace make:apikey \"App Name\"\n\n";
            } else {
                printf("  %-4s | %-20s | %-10s | %-8s | %-20s | %-20s\n", 'ID', 'Name', 'Prefix', 'Status', 'Last Used', 'Expires');
                echo "  " . str_repeat('-', 94) . "\n";
                foreach ($keys as $k) {
                    $status = (int)$k['is_active'] === 1 ? 'Active' : 'Revoked';
                    $lastUsed = $k['last_used_at'] ?? 'Never';
                    $expires = $k['expires_at'] ?? 'Never';
                    printf("  %-4s | %-20s | %-10s | %-8s | %-20s | %-20s\n", 
                        $k['id'], 
                        substr($k['name'], 0, 20), 
                        $k['prefix'], 
                        $status, 
                        $lastUsed, 
                        $expires
                    );
                }
                echo "\n";
            }
        } catch (\Throwable $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'apikey:revoke':
        $prefix = $args[2] ?? null;
        if (!$prefix) {
            echo "❌ Error: Please specify the API key prefix to revoke. e.g. php ace apikey:revoke a1b2c3d4\n\n";
            exit(1);
        }
        try {
            if (\Ace\ApiKey::revoke($prefix)) {
                echo "✅ API Key with prefix '{$prefix}' has been revoked (deactivated).\n\n";
            } else {
                echo "⚠️  No active API key found with prefix '{$prefix}'.\n\n";
            }
        } catch (\Throwable $e) {
            echo "❌ Error: " . $e->getMessage() . "\n\n";
        }
        break;

    case 'help':
    default:
        echo "Available Commands:\n";
        echo "  serve                    Starts the local development server (like artisan serve).\n";
        echo "  test                     Runs the PHPUnit test suite.\n";
        echo "  down [--secret=token]    Puts application into maintenance mode.\n";
        echo "  up                       Brings application out of maintenance mode.\n";
        echo "  migrate                  Runs database schemas migrations.\n";
        echo "  migrate:rollback         Rolls back the last migration batch.\n";
        echo "  migrate:status           Displays the status of all migrations.\n";
        echo "  db:seed [--class=Name]   Seeds the database with test records (default: DatabaseSeeder).\n";
        echo "  make:migration <name>    Generates a boilerplate timestamped migration file.\n";
        echo "  make:controller <Name>   Generates a boilerplate Controller class.\n";
        echo "  make:model <Name>        Generates a boilerplate Active Record Model class.\n";
        echo "  make:service <Name>      Generates a Service class for domain business logic.\n";
        echo "  make:repository <Name>   Generates a Repository class for data access abstraction.\n";
        echo "  make:request <Name>      Generates a FormRequest class for validated request input.\n";
        echo "  make:apikey <Name>       Generates a secure API key for frontends (React/Next/Nuxt).\n";
        echo "  apikey:list              Lists all registered API keys.\n";
        echo "  apikey:revoke <prefix>   Deactivates an API key by prefix.\n";
        echo "  make:middleware <Name>   Generates a boilerplate Middleware class.\n";
        echo "  make:action <Name>       Generates an Action class for single-purpose business logic.\n";
        echo "  make:event <Name>        Generates an Event class.\n";
        echo "  make:listener <Name>     Generates an Event Listener class.\n";
        echo "  make:seeder <Name>       Generates a boilerplate Seeder class.\n";
        echo "  view:clear               Wipes all cached, compiled view templates.\n";
        echo "  help                     Shows this help manual.\n\n";
        break;
}

